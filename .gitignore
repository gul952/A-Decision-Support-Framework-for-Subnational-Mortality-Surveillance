# --- DHS microdata: NEVER commit, NEVER redistribute (terms of use) ---
data/raw/dhs/*
!data/raw/dhs/README.md
*.dta
*.sav
*.DTA
*.SAV
# GPS/cluster-level DHS shapefiles and their sidecar files
*.shp
*.shx
*.dbf
*.prj
*.cpg
# DHS flat-file exports occasionally distributed as .csv/.zip/.rar -- these
# are DHS microdata if they came from dhsprogram.com, not this project's own
# processed/public CSVs (which are explicitly listed and never match these
# patterns because they don't live under data/raw/dhs/).
data/raw/dhs/**/*.csv
data/raw/dhs/**/*.zip
data/raw/dhs/**/*.rar

# --- DHS-derived intermediate/granular files: kept local, not published.
# These are more granular than final district-level results (cluster-
# level lookups, person-record-level survival data) -- final district
# aggregates in data/processed/mortality/, features/, models/, decision/
# ARE published; this directory specifically is not. See
# docs/DATA_SOURCES.md for the reasoning. ---
data/processed/dhs_derived/*
!data/processed/dhs_derived/README.md

# --- IHME GBD raw downloaded data files: not redistributed.
# The IHME Free-of-Charge Non-Commercial User Agreement prohibits
# "provid[ing] to third parties the ability to download IHME Data Sets
# from User-provided hosting facilities" without written permission --
# hosting these raw downloaded files on a public git remote is exactly
# that. Citation files (no IHME data values) and this project's own
# derived comparison results (data/processed/models/gbd_validation_comparison.csv)
# are unaffected and remain committed -- see THIRD_PARTY_DATA_LICENSES.md. ---
data/external/gbd/IHME-GBD_2023_DATA-*.csv

# --- Large model trace: regeneratable via scripts/models/04_hierarchical_hazard_sae.py,
# not needed in version control. ---
models/hierarchical_hazard_sae_trace.pkl

# --- Large raw source dumps (re-fetchable via docs/DATA_SOURCES.md) ---
data/raw/pbs2017-main/
*.tar.gz

# --- Standard Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- OS / editor ---
.DS_Store
.vscode/

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter checkpoint clutter already covered above ---

# --- Credentials / secrets / local config: NEVER commit ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
secrets.yml
secrets.yaml
config.local.*
*.local.env
.netrc
.aws/
.dhsprogram_credentials

# --- Local paths / machine-specific settings ---
.direnv/
*.local.json

# --- Large regeneratable model artifacts (see docs/DATA_SOURCES.md for
# how to regenerate) ---
*.trace.pkl
*.nc
